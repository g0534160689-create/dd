<Window x:Class="DaatAharon.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="דעת אהרן | מרכז ניהול" Height="820" Width="1320" MinHeight="680" MinWidth="1080"
 WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}"
 FlowDirection="RightToLeft" FontFamily="Segoe UI">
 <Window.Resources>
  <Style x:Key="NavButton" TargetType="Button">
   <Setter Property="HorizontalContentAlignment" Value="Right"/><Setter Property="Foreground" Value="#C9D4E7"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="12,13"/><Setter Property="Margin" Value="0,2"/>
   <Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/>
  </Style>
 </Window.Resources>
 <Grid Margin="22">
  <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="18">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,4,0,28">
     <TextBlock Text="דעת אהרן" Foreground="White" FontSize="25" FontWeight="Bold"/>
     <TextBlock Text="מרכז שליטה וניהול" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0"/>
    </StackPanel>
    <StackPanel>
     <Button Content="⌂   לוח בקרה" Style="{StaticResource NavButton}" />
     <Button Content="◈   דפדפן מאובטח" Style="{StaticResource NavButton}"/>
     <Button Content="⊘   מדיניות וחסימות" Style="{StaticResource NavButton}"/>
     <Button Content="▣   ניהול חלונות קופצים" Style="{StaticResource NavButton}"/>
     <Button Content="⚙   הגדרות מערכת" Style="{StaticResource NavButton}"/>
     <Button Content="◷   יומן פעילות" Style="{StaticResource NavButton}"/>
    </StackPanel>
    <Border DockPanel.Dock="Bottom" Background="#1C2940" CornerRadius="12" Padding="12" Margin="0,20,0,0">
     <StackPanel><TextBlock Text="גרסה 1.0.0" Foreground="White" FontWeight="SemiBold"/><TextBlock Text=".NET 10 · Windows x64" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
    </Border>
   </DockPanel>
  </Border>
  <StackPanel Grid.Column="2">
   <Grid Margin="0,0,0,22">
    <StackPanel><TextBlock Text="שלום וברוכים הבאים" Foreground="White" FontSize="28" FontWeight="Bold"/><TextBlock Text="כל כלי הניהול במקום אחד" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,6,0,0"/></StackPanel>
    <Border HorizontalAlignment="Left" Background="#173B32" CornerRadius="20" Padding="13,8"><TextBlock Text="● המערכת מוכנה" Foreground="#74E0B2" FontSize="12"/></Border>
   </Grid>
   <UniformGrid Columns="3" Margin="0,0,0,18">
    <Border Background="{StaticResource PanelBrush}" CornerRadius="15" Padding="18" Margin="0,0,10,0"><StackPanel><TextBlock Text="אתרים מורשים" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="0" Foreground="White" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Text="רשימת גישה" Foreground="#74E0B2" FontSize="11"/></StackPanel></Border>
    <Border Background="{StaticResource PanelBrush}" CornerRadius="15" Padding="18" Margin="5,0"><StackPanel><TextBlock Text="אתרים חסומים" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="0" Foreground="White" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Text="מדיניות חסימה" Foreground="#FFB36B" FontSize="11"/></StackPanel></Border>
    <Border Background="{StaticResource PanelBrush}" CornerRadius="15" Padding="18" Margin="10,0,0,0"><StackPanel><TextBlock Text="אירועים היום" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="0" Foreground="White" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Text="יומן פעילות" Foreground="#8DB6FF" FontSize="11"/></StackPanel></Border>
   </UniformGrid>
   <Border Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="24">
    <StackPanel>
     <TextBlock Text="מתחילים לעבוד" Foreground="White" FontSize="20" FontWeight="Bold"/>
     <TextBlock Text="הבסיס החדש נבנה במבנה מודולרי. מכאן יתווספו כלי הדפדפן, המדיניות והניהול." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,20"/>
     <Border Background="#1B2A43" CornerRadius="12" Padding="16"><StackPanel><TextBlock Text="תשתית חדשה ונקייה" Foreground="White" FontWeight="SemiBold"/><TextBlock Text="הפרדה בין ממשק, שירותים, נתונים ואבחון תקלות." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel></Border>
    </StackPanel>
   </Border>
  </StackPanel>
 </Grid>
</Window>
